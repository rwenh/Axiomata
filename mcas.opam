# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A TUI mini computer-algebra system, built on a hand-rolled parser-combinator library"
description: """
mcas parses, evaluates, symbolically simplifies, and differentiates simple
arithmetic expressions, wrapped in a small terminal UI. Everything from the
parser-combinator library on up -- the expression grammar, the evaluator,
the simplifier, and the differentiator -- is written from scratch, leaning
on OCaml's algebraic data types and pattern matching throughout."""
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "4.14"}
  "notty"
  "cmdliner"
  "alcotest" {with-test & >= "1.5"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
